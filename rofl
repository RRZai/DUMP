local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local EnemyService = workspace:WaitForChild("EnemyService")

local lp = Players.LocalPlayer
local BEHIND_OFFSET = 6
local DEAD_HP = 0.01
local MAX_DISTANCE = 1000

-- Cooldown Variables
local C_COOLDOWN = 15 
local V_COOLDOWN = 6 

-- Toggle Variables
local toggled = false
local disabledByPlayer = false
local wasForceDisabled = false 
local lastToggle = 0
local lockConn = nil

-- Sound Variables
local lastDangerTime = 0

-- Key Codes
local KeyCode_Z = Enum.KeyCode.Z
local KeyCode_X = Enum.KeyCode.X
local KeyCode_C = Enum.KeyCode.C
local KeyCode_V = Enum.KeyCode.V
local KeyCode_G = Enum.KeyCode.G

----------------------------------------------------
-- MOBILE TOGGLE UI CREATION
----------------------------------------------------
local btn = nil -- Declare early so functions below can see it

local function createToggleUI()
    -- ScreenGui (CoreGui keeps it on top of everything, even when menu is open)
    local gui = Instance.new("ScreenGui")
    gui.Name = "MacroToggleGui"
    gui.ResetOnSpawn = false
    gui.Parent = game:GetService("CoreGui")

    -- Main Button
    btn = Instance.new("TextButton")
    btn.Name = "ToggleBtn"
    btn.Size = UDim2.new(0, 100, 0, 40)
    btn.Position = UDim2.new(0, 20, 0.5, 0) -- Left side, middle of screen
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.AutoButtonColor = true
    btn.Parent = gui

    -- Make it look nice and round
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    -- Add a subtle stroke
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(100, 100, 100)
    stroke.Parent = btn

    -- Make it draggable (optional but highly recommended for mobile)
    local dragging, dragInput, dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

createToggleUI() -- Build the UI immediately

----------------------------------------------------
-- SOUND SYSTEM
----------------------------------------------------
local function playAlarm(soundId, volume)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. soundId
    sound.Volume = volume or 0.5
    sound.Parent = workspace
    sound:Play()
    sound.Ended:Connect(function()
        if sound and sound.Parent then sound:Destroy() end
    end)
    task.delay(15, function()
        if sound and sound.Parent then sound:Destroy() end
    end)
end

----------------------------------------------------
-- ANTI-PLAYER DETECTION SYSTEM
----------------------------------------------------
Players.PlayerAdded:Connect(function(player)
    playAlarm(138656991212198, 1)
end)

task.spawn(function()
    while task.wait(0.5) do
        local myChar = lp.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then continue end

        local playerNearby = false

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                local pChar = p.Character
                local pHRP = pChar and pChar:FindFirstChild("HumanoidRootPart")
                
                if pHRP then
                    local dist = (myHRP.Position - pHRP.Position).Magnitude
                    if dist <= 800 then
                        playerNearby = true
                        break 
                    end
                end
            end
        end

        if playerNearby then
            if toggled and not disabledByPlayer then
                disabledByPlayer = true
                wasForceDisabled = true
                disableAll() -- This will automatically update the button color to OFF
                playAlarm(18132053173, 1) 
                lastDangerTime = tick()
            elseif disabledByPlayer and wasForceDisabled and (tick() - lastDangerTime > 4) then
                playAlarm(18132053173, 0.5)
                lastDangerTime = tick()
            end
        else
            if disabledByPlayer and wasForceDisabled then
                disabledByPlayer = false
                wasForceDisabled = false
                enableAll() -- This will automatically update the button color to ON
            end
        end
    end
end)

----------------------------------------------------
-- COMBAT & TARGETING SYSTEM
----------------------------------------------------

local function holdKey(key)
    VIM:SendKeyEvent(true, key, false, game)
end

local function releaseKey(key)
    VIM:SendKeyEvent(false, key, false, game)
end

local function tapKey(key)
    holdKey(key)
    task.wait(0.05)
    releaseKey(key)
end

local function getTarget()
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    local tier1_Bosses = {}
    local tier2_Soldiers = {}
    local tier3_Others = {}

    for _, enemy in ipairs(EnemyService:GetChildren()) do
        if enemy:IsA("Model") then
            local hum = enemy:FindFirstChild("Humanoid")
            local hrp = enemy:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > DEAD_HP then
                local dist = (hrp.Position - myPos).Magnitude
                
                if dist <= MAX_DISTANCE then
                    local data = {enemy = enemy, dist = dist}
                    local nameLower = enemy.Name:lower()
                    
                    local levelStr = enemy.Name:match("%[Lv%.(%d+)%]")
                    local level = tonumber(levelStr) or 0

                    if level == 15000 then
                        table.insert(tier1_Bosses, data)
                    elseif level == 13000 and nameLower:find("soldier") then
                        table.insert(tier2_Soldiers, data)
                    else
                        table.insert(tier3_Others, data)
                    end
                end
            end
        end
    end

    local function getClosest(tab)
        if #tab == 0 then return nil end
        table.sort(tab, function(a, b) return a.dist < b.dist end)
        return tab[1].enemy
    end

    return getClosest(tier1_Bosses) or getClosest(tier2_Soldiers) or getClosest(tier3_Others)
end

local function lockBehindEnemy()
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = getTarget()
    if target and target:FindFirstChild("HumanoidRootPart") then
        local targetHRP = target.HumanoidRootPart
        local behindCF = targetHRP.CFrame * CFrame.new(0, 0, BEHIND_OFFSET)
        
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.CFrame = behindCF
    end
end

local function combatLoop()
    local zCasts = 0
    local lastCTime = tick() - (C_COOLDOWN - 0.5) 
    local lastVTime = tick() - (V_COOLDOWN - 1)

    while toggled do
        local timeSinceC = tick() - lastCTime
        local timeUntilC = C_COOLDOWN - timeSinceC
        local timeSinceV = tick() - lastVTime

        if timeSinceC >= C_COOLDOWN then
            releaseKey(KeyCode_Z) 
            task.wait(0.1)
            tapKey(KeyCode_C) 
            
            for i = 1, 20 do 
                if not toggled then return end
                task.wait(0.1)
            end
            
            tapKey(KeyCode_V) 
            lastCTime = tick()
            lastVTime = tick()
            zCasts = 0 
            task.wait(0.2)
            
        elseif timeUntilC <= 2.0 then
            releaseKey(KeyCode_Z)
            task.wait(0.1)
            
        elseif timeSinceV >= V_COOLDOWN then
            releaseKey(KeyCode_Z)
            task.wait(0.1)
            tapKey(KeyCode_V)
            lastVTime = tick()
            zCasts = 0 
            task.wait(0.2)
            
        else
            holdKey(KeyCode_Z)
            task.wait(0.8)
            zCasts = zCasts + 1
            
            if zCasts >= 2 then
                releaseKey(KeyCode_Z)
                task.wait(0.1)
                tapKey(KeyCode_X)
                zCasts = 0 
                task.wait(0.2)
            end
        end
    end
    
    releaseKey(KeyCode_Z)
    releaseKey(KeyCode_X)
    releaseKey(KeyCode_C)
    releaseKey(KeyCode_V)
end

----------------------------------------------------
-- TOGGLE FUNCTIONS (Now controls the button visuals too)
----------------------------------------------------

local function enableAll()
    toggled = true
    if btn then
        btn.Text = "ON"
        btn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) -- Green when on
    end
    lockConn = RunService.RenderStepped:Connect(lockBehindEnemy)
    task.spawn(combatLoop)
end

local function disableAll()
    toggled = false
    if btn then
        btn.Text = "OFF"
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) -- Dark gray when off
    end
    if lockConn then
        lockConn:Disconnect()
        lockConn = nil
    end
end

-- Unified toggle logic so PC and Mobile do the exact same thing
local function handleToggle()
    if tick() - lastToggle < 0.3 then return end
    lastToggle = tick()
    
    if toggled then
        disableAll()
        disabledByPlayer = false
        wasForceDisabled = false
    else
        if disabledByPlayer then
            -- Panic cancel
            disabledByPlayer = false
            wasForceDisabled = false
        else
            enableAll()
        end
    end
end

----------------------------------------------------
-- INPUT LISTENERS (PC Keyboard + Mobile Button)
----------------------------------------------------

-- PC Keyboard Listener
RunService.RenderStepped:Connect(function()
    if UserInputService:IsKeyDown(KeyCode_G) then
        handleToggle()
    end
end)

-- Mobile Button Listener
if btn then
    btn.MouseButton1Click:Connect(handleToggle)
end
