-- COMBAT TARGETING & EXECUTION
----------------------------------------------------
local function holdKey(key) VIM:SendKeyEvent(true, key, false, game) end
local function releaseKey(key) VIM:SendKeyEvent(false, key, false, game) end
local function tapKey(key) holdKey(key); task.wait(0.05); releaseKey(key) end

local function getTarget()
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position
    local tier1_Bosses, tier2_Soldiers, tier3_Others = {}, {}, {}
    for _, enemy in ipairs(EnemyService:GetChildren()) do
        if enemy:IsA("Model") then
            local hum, hrp = enemy:FindFirstChild("Humanoid"), enemy:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > DEAD_HP then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= MAX_DISTANCE then
                    local data = {enemy = enemy, dist = dist}
                    local level = tonumber(enemy.Name:match("%[Lv%.(%d+)%]")) or 0
                    if level == 15000 then table.insert(tier1_Bosses, data)
                    elseif level == 13000 and enemy.Name:lower():find("soldier") then table.insert(tier2_Soldiers, data)
                    else table.insert(tier3_Others, data) end
                end
            end
        end
    end
    local function getClosest(tab) if #tab == 0 then return nil end table.sort(tab, function(a, b) return a.dist < b.dist end) return tab[1].enemy end
    return getClosest(tier1_Bosses) or getClosest(tier2_Soldiers) or getClosest(tier3_Others)
end

local function lockBehindEnemy()
    if getgenv().MacroKilled then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = getTarget()
    if target and target:FindFirstChild("HumanoidRootPart") then
        local behindCF = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, BEHIND_OFFSET)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.CFrame = behindCF
    end
end

local function combatLoop()
    local zCasts = 0
    local lastCTime = tick() - (C_COOLDOWN - 0.5) 
    local lastVTime = tick() - (V_COOLDOWN - 1)
    while toggled and not getgenv().MacroKilled do
        local timeSinceC = tick() - lastCTime
        local timeUntilC = C_COOLDOWN - timeSinceC
        local timeSinceV = tick() - lastVTime
        if timeSinceC >= C_COOLDOWN then
            releaseKey(KeyCode_Z); task.wait(0.1); tapKey(KeyCode_C)
            for i = 1, 20 do if not toggled or getgenv().MacroKilled then return end task.wait(0.1) end
            tapKey(KeyCode_V); lastCTime = tick(); lastVTime = tick(); zCasts = 0; task.wait(0.2)
        elseif timeUntilC <= 2.0 then
            releaseKey(KeyCode_Z); task.wait(0.1)
        elseif timeSinceV >= V_COOLDOWN then
            releaseKey(KeyCode_Z); task.wait(0.1); tapKey(KeyCode_V); lastVTime = tick(); zCasts = 0; task.wait(0.2)
        else
            holdKey(KeyCode_Z); task.wait(0.8); zCasts = zCasts + 1
            if zCasts >= 2 then releaseKey(KeyCode_Z); task.wait(0.1); tapKey(KeyCode_X); zCasts = 0; task.wait(0.2) end
        end
    end
    releaseKey(KeyCode_Z); releaseKey(KeyCode_X); releaseKey(KeyCode_C); releaseKey(KeyCode_V)
end

