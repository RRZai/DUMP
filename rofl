local function enableAll()
    toggled = true
    SaveToggleState("ON") -- SAVE TO DELTA WORKSPACE
    if btn then btn.Text = "ON"; btn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) end
    lockConn = RunService.RenderStepped:Connect(lockBehindEnemy)
    task.spawn(combatLoop)
end

local function disableAll()
    toggled = false
    SaveToggleState("OFF") -- SAVE TO DELTA WORKSPACE
    if btn then btn.Text = "OFF"; btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) end
    if lockConn then lockConn:Disconnect(); lockConn = nil end
end

local function handleToggle()
    if tick() - lastToggle < 0.3 then return end
    lastToggle = tick()
    if toggled then
        disableAll(); disabledByPlayer = false; wasForceDisabled = false
    else
        if disabledByPlayer then disabledByPlayer = false; wasForceDisabled = false
        else enableAll() end
    end
end

RunService.RenderStepped:Connect(function()
    if getgenv().MacroKilled then return end
    if UserInputService:IsKeyDown(KeyCode_G) then handleToggle() end
end)

